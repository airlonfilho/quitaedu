# Copie para .env e preencha com valores reais. Nunca commitar .env.

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Gerar com: openssl rand -base64 32
AUTH_SECRET=""

# Role de runtime sem BYPASSRLS, criado pela migration multi_tenant_rls.
# Gerar/rotacionar com: npx tsx prisma/set-runtime-role-password.ts
RUNTIME_DATABASE_URL="postgresql://quitaedu_app:password@host:5432/dbname?schema=public"

# Asaas sandbox. A chave real começa com "$aact_hmlg_..." — guarde SEM o "$"
# aqui (ver comentário em .env) e deixe src/lib/asaas.ts prefixar de volta.
ASAAS_SANDBOX_BASE_URL="https://api-sandbox.asaas.com/v3"
ASAAS_SANDBOX_API_KEY_NO_PREFIX="aact_hmlg_..."
ASAAS_SANDBOX_WALLET_ID=""

# Gerar com: openssl rand -hex 32 — use o mesmo valor no authToken ao
# registrar o webhook no Asaas (POST /v3/webhooks).
ASAAS_WEBHOOK_TOKEN=""

# Gerar com: openssl rand -hex 24 — autentica os endpoints /api/cron/*.
CRON_SECRET=""

# Sentry (P-001, monitoramento/alertas) — via integração Vercel↔Sentry
# (Project → Integrations no painel do Vercel). DSN é público por natureza;
# AUTH_TOKEN é usado só no build pra subir source maps.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
