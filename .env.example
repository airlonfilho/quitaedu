# Copie para .env e preencha com valores reais. Nunca commitar .env.

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Gerar com: openssl rand -base64 32
AUTH_SECRET=""

# Role de runtime sem BYPASSRLS, criado pela migration multi_tenant_rls.
# Gerar/rotacionar com: npx tsx prisma/set-runtime-role-password.ts
RUNTIME_DATABASE_URL="postgresql://quitaedu_app:password@host:5432/dbname?schema=public"
